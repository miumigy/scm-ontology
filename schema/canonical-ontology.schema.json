{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miumigy/scm-ontology/schema/canonical-ontology.schema.json",
  "title": "SCM Ontology Canonical Model",
  "description": "Machine-readable serialization contract for the S113-S115 canonical semantic model.",
  "type": "object",
  "required": ["ontology", "version", "concepts", "relationships"],
  "properties": {
    "ontology": {"const": "scm-ontology"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "concepts": {"type": "array", "items": {"$ref": "#/$defs/concept"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}
  },
  "$defs": {
    "concept": {
      "type": "object",
      "required": ["name", "layer", "dimension"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "layer": {"enum": ["primitive", "core", "derived", "contextual"]},
        "dimension": {"enum": ["physical", "information", "decision", "semantic"]},
        "description": {"type": "string"},
        "attributes": {"type": "array", "items": {"$ref": "#/$defs/attribute"}}
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": ["name", "value_type", "role", "cardinality"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value_type": {"type": "string", "minLength": 1},
        "role": {"enum": ["identity", "descriptive", "qualifier", "measure", "temporal", "epistemic", "provenance", "derivation", "governance", "reference"]},
        "cardinality": {"enum": ["1", "0..1", "0..*", "1..*"]},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["predicate", "source", "target", "category"],
      "properties": {
        "predicate": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "category": {"enum": ["physical", "informational", "temporal", "causal", "epistemic", "organizational", "operational", "governance", "semantic"]},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
