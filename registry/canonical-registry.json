{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "registryId": "scm-ontology-canonical-registry",
  "version": "0.2.0",
  "status": "reference",
  "sourceModule": "src/scm_ontology/canonical_model.py",
  "principles": [
    "Canonical Truth is governed and is never created implicitly by mapping, similarity, inference, projection, or ingestion.",
    "Registry metadata defines semantic vocabulary; it is not a storage schema.",
    "Stable concept and predicate references MUST remain deterministic and versioned."
  ],
  "concepts": [
    {"id":"Entity","layer":"primitive","worlds":["semantic"],"description":"Canonical identifiable thing.","abstract":true},
    {"id":"Event","layer":"primitive","worlds":["semantic"],"description":"Occurrence associated with a context.","abstract":false},
    {"id":"State","layer":"primitive","worlds":["semantic"],"description":"Condition or configuration that holds.","abstract":false},
    {"id":"Observation","layer":"primitive","worlds":["information"],"description":"Representation of something observed; not an inference.","abstract":false},
    {"id":"Time","layer":"primitive","worlds":["semantic"],"description":"Temporal semantics; not a required entity for an instant.","abstract":false},
    {"id":"Actor","layer":"core","worlds":["physical","decision"],"description":"Participant capable of roles or decisions.","abstract":false},
    {"id":"Organization","layer":"core","worlds":["physical","decision"],"description":"Organizational actor.","abstract":false},
    {"id":"Location","layer":"core","worlds":["physical"],"description":"Geographic or logical place.","abstract":false},
    {"id":"Node","layer":"core","worlds":["physical"],"description":"Operational role in a supply-chain network.","abstract":false},
    {"id":"Product","layer":"core","worlds":["physical"],"description":"Intended output or sellable supply-chain item.","abstract":false},
    {"id":"Material","layer":"core","worlds":["physical"],"description":"Input or component used by transformation.","abstract":false},
    {"id":"Resource","layer":"core","worlds":["physical"],"description":"Capacity-bearing means used by operations.","abstract":false},
    {"id":"Inventory","layer":"core","worlds":["physical"],"description":"Stock position in an item/context/time.","abstract":false},
    {"id":"Demand","layer":"core","worlds":["information"],"description":"Requirement or expected need.","abstract":false},
    {"id":"Order","layer":"core","worlds":["information"],"description":"Business request or transaction.","abstract":false},
    {"id":"Supply","layer":"core","worlds":["physical","information"],"description":"Provision or availability of supply-chain capability.","abstract":false},
    {"id":"Capacity","layer":"core","worlds":["physical"],"description":"Available or usable capability over a scope and period.","abstract":false},
    {"id":"Flow","layer":"core","worlds":["physical"],"description":"Movement or transformation through the supply chain.","abstract":false},
    {"id":"Fulfillment","layer":"core","worlds":["physical","information"],"description":"Satisfaction of demand or order requirements.","abstract":false},
    {"id":"Objective","layer":"core","worlds":["decision"],"description":"Desired outcome or optimization direction.","abstract":false},
    {"id":"Constraint","layer":"core","worlds":["decision"],"description":"Boundary limiting feasible decisions or actions.","abstract":false},
    {"id":"Policy","layer":"core","worlds":["decision"],"description":"Governing decision rule or preference structure.","abstract":false},
    {"id":"Rule","layer":"core","worlds":["decision"],"description":"Explicit conditional or prescriptive logic.","abstract":false},
    {"id":"Plan","layer":"core","worlds":["decision"],"description":"Intended future configuration or action set.","abstract":false},
    {"id":"Schedule","layer":"core","worlds":["decision"],"description":"Time-positioned plan or activity arrangement.","abstract":false},
    {"id":"Commitment","layer":"core","worlds":["decision"],"description":"Explicit promise or obligation.","abstract":false},
    {"id":"Recommendation","layer":"core","worlds":["decision"],"description":"Suggested course of action or alternative; not a decision.","abstract":false},
    {"id":"Decision","layer":"core","worlds":["decision"],"description":"Selected or authorized course of action.","abstract":false},
    {"id":"Action","layer":"core","worlds":["decision","physical"],"description":"Intended operational intervention; not the execution record.","abstract":false},
    {"id":"Execution","layer":"core","worlds":["physical","information"],"description":"Record of carrying out an Action; not itself an outcome.","abstract":false},
    {"id":"Outcome","layer":"core","worlds":["semantic"],"description":"Result associated with action, decision, execution, or context.","abstract":false},
    {"id":"Measurement","layer":"core","worlds":["information"],"description":"Measured value with unit, method, and context.","abstract":false},
    {"id":"MetricDefinition","layer":"core","worlds":["information"],"description":"Meaning and calculation definition of a metric.","abstract":false},
    {"id":"MetricValue","layer":"core","worlds":["information"],"description":"Evaluated value of a MetricDefinition in context.","abstract":false},
    {"id":"KPI","layer":"derived","worlds":["information","decision"],"description":"Governed selection of one or more metrics for an objective or decision context.","abstract":false},
    {"id":"PerformanceAssessment","layer":"derived","worlds":["information","decision"],"description":"Contextual assessment against an explicit reference basis.","abstract":false},
    {"id":"Variance","layer":"derived","worlds":["information"],"description":"Defined difference between comparable values.","abstract":false},
    {"id":"RiskScore","layer":"derived","worlds":["information","decision"],"description":"Derived risk representation.","abstract":false},
    {"id":"Identity","layer":"contextual","worlds":["semantic"],"description":"Canonical identity and source-reference context.","abstract":false},
    {"id":"Provenance","layer":"contextual","worlds":["semantic"],"description":"Origin and derivation context.","abstract":false},
    {"id":"Evidence","layer":"contextual","worlds":["semantic"],"description":"Evidence supporting an assertion, derivation, or assessment.","abstract":false},
    {"id":"Scenario","layer":"contextual","worlds":["semantic"],"description":"Alternative contextual world or assumption set.","abstract":false},
    {"id":"UnitOfMeasure","layer":"contextual","worlds":["semantic"],"description":"Measurement dimensional context.","abstract":false},
    {"id":"Target","layer":"contextual","worlds":["decision"],"description":"Desired or governed reference value/range.","abstract":false},
    {"id":"Threshold","layer":"contextual","worlds":["decision"],"description":"Boundary affecting status or rule evaluation.","abstract":false},
    {"id":"LearningResult","layer":"contextual","worlds":["information","decision"],"description":"Explicit incorporation of evidence into future knowledge or decision context.","abstract":false}
  ],
  "relationships": [
    {"predicate":"contains","source":"Entity","target":"Entity","category":"structural"},
    {"predicate":"part_of","source":"Entity","target":"Entity","category":"structural"},
    {"predicate":"located_at","source":"Entity","target":"Location","category":"structural"},
    {"predicate":"plays_role","source":"Actor","target":"Entity","category":"participation"},
    {"predicate":"places","source":"Actor","target":"Order","category":"participation"},
    {"predicate":"receives","source":"Actor","target":"Entity","category":"participation"},
    {"predicate":"executes","source":"Actor","target":"Action","category":"participation"},
    {"predicate":"moves_through","source":"Flow","target":"Node","category":"flow"},
    {"predicate":"flows_to","source":"Flow","target":"Node","category":"flow"},
    {"predicate":"supplies","source":"Actor","target":"Supply","category":"flow"},
    {"predicate":"consumes","source":"Flow","target":"Material","category":"flow"},
    {"predicate":"produces","source":"Flow","target":"Product","category":"transformation"},
    {"predicate":"transforms","source":"Flow","target":"Product","category":"transformation"},
    {"predicate":"fulfills","source":"Fulfillment","target":"Demand","category":"fulfillment"},
    {"predicate":"allocated_to","source":"Supply","target":"Demand","category":"fulfillment"},
    {"predicate":"reserved_for","source":"Supply","target":"Demand","category":"fulfillment"},
    {"predicate":"planned_for","source":"Plan","target":"Entity","category":"planning"},
    {"predicate":"scheduled_for","source":"Schedule","target":"Entity","category":"planning"},
    {"predicate":"committed_to","source":"Commitment","target":"Entity","category":"commitment"},
    {"predicate":"informs","source":"Recommendation","target":"Decision","category":"decision"},
    {"predicate":"considers","source":"Decision","target":"Entity","category":"decision"},
    {"predicate":"selects","source":"Decision","target":"Entity","category":"decision"},
    {"predicate":"has_objective","source":"Decision","target":"Objective","category":"governance"},
    {"predicate":"constrained_by","source":"Decision","target":"Constraint","category":"governance"},
    {"predicate":"governed_by","source":"Decision","target":"Policy","category":"governance"},
    {"predicate":"authorized_by","source":"Action","target":"Decision","category":"governance"},
    {"predicate":"execution_of","source":"Execution","target":"Action","category":"execution"},
    {"predicate":"executed_by","source":"Execution","target":"Actor","category":"execution"},
    {"predicate":"results_in","source":"Execution","target":"Outcome","category":"lifecycle"},
    {"predicate":"observes","source":"Observation","target":"Entity","category":"epistemic"},
    {"predicate":"measures","source":"Measurement","target":"Entity","category":"measurement"},
    {"predicate":"defines","source":"MetricDefinition","target":"Entity","category":"measurement"},
    {"predicate":"evaluated_by","source":"PerformanceAssessment","target":"MetricDefinition","category":"evaluation"},
    {"predicate":"supported_by","source":"Entity","target":"Evidence","category":"provenance"},
    {"predicate":"derived_from","source":"Entity","target":"Entity","category":"derivation"},
    {"predicate":"causes","source":"Entity","target":"Entity","category":"causal"},
    {"predicate":"affects","source":"Entity","target":"Entity","category":"causal"},
    {"predicate":"depends_on","source":"Entity","target":"Entity","category":"dependency"},
    {"predicate":"learns_from","source":"LearningResult","target":"Evidence","category":"learning"},
    {"predicate":"updates","source":"LearningResult","target":"Entity","category":"learning"},
    {"predicate":"supersedes","source":"Entity","target":"Entity","category":"lifecycle"},
    {"predicate":"scoped_to","source":"Entity","target":"Scenario","category":"structural"}
  ]
}
