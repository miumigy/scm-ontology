{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miumigy/scm-ontology/blob/main/registry/schemas/canonical-registry.v0.2.schema.json",
  "title": "SCM Ontology Canonical Registry v0.2",
  "description": "Versioned machine-readable semantic vocabulary for the SCM Ontology canonical registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registryId", "version", "status", "sourceModule", "principles", "concepts", "relationships"],
  "properties": {
    "$schema": {"type": "string", "const": "https://json-schema.org/draft/2020-12/schema"},
    "registryId": {"type": "string", "const": "scm-ontology-canonical-registry"},
    "version": {"type": "string", "const": "0.2.0", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["reference", "draft", "deprecated"]},
    "sourceModule": {"type": "string", "const": "src/scm_ontology/canonical_model.py"},
    "principles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "worlds", "description", "abstract"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "enum": ["primitive", "core", "derived", "contextual"]},
          "worlds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["physical", "information", "decision", "semantic"]}},
          "description": {"type": "string", "minLength": 1},
          "abstract": {"type": "boolean"}
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "source", "target", "category"],
        "properties": {
          "predicate": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "category": {"type": "string", "enum": ["structural", "participation", "flow", "transformation", "fulfillment", "planning", "commitment", "lifecycle", "governance", "decision", "execution", "epistemic", "measurement", "derivation", "evaluation", "provenance", "causal", "dependency", "learning"]}
        }
      }
    }
  }
}
