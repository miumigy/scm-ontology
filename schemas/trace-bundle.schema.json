{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scm-ontology.dev/schema/trace-bundle",
  "title": "SCM Ontology Trace Bundle",
  "description": "Versioned interchange contract for a validated SCM decision lifecycle trace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "bundle"],
  "properties": {
    "$schema": {"const": "https://scm-ontology.dev/schema/trace-bundle"},
    "schema_version": {"const": "1.0.0"},
    "bundle": {
      "type": "object",
      "required": ["decision_trace", "execution_request", "execution_event", "reasoning_provenance", "validation"],
      "properties": {
        "decision_trace": {"type": "object"},
        "execution_request": {"type": "object"},
        "execution_event": {"type": "object"},
        "reasoning_provenance": {"type": "object"},
        "advisories": {"type": "array"},
        "validation": {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": {
            "valid": {"const": true},
            "errors": {"const": []}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
